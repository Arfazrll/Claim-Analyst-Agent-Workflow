# Copy to .env and fill the secrets (`make secrets` generates them). Never commit .env.

# --- secrets -------------------------------------------------------------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# >= 32 random characters
JWT_SECRET=
# base64 of exactly 32 random bytes (AES-256-GCM key for claim data at rest)
DATA_ENCRYPTION_KEY=
METRICS_TOKEN=

# First administrator, created on first start when no user exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- blockchain (local Anvil dev chain) -----------------------------------------
# These are Anvil's PUBLIC well-known dev accounts (#0 deployer/owner, #1 backend
# writer). Fine for the local chain only; NEVER use them on a real network.
CHAIN_DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CHAIN_WRITER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
CHAIN_WRITER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# --- web -------------------------------------------------------------------------
PUBLIC_ORIGIN=http://localhost:8080
# Set to true behind HTTPS.
COOKIE_SECURE=false
ALLOW_REGISTRATION=true

# --- optional language model (OpenAI-compatible; leave offline to run keyless) ------
LLM_PROVIDER=offline
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash-lite
